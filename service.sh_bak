#!/system/bin/sh
# Charging control directory.
sleep 1m
BASEDIR="/sys/class/power_supply/battery"
# Battery temperature node.
warm="$BASEDIR/temp"
# Battery capacity node.
power="$BASEDIR/capacity"
# Prepare control-node permissions.
chattr -i $BASEDIR/constant_charge_current
chmod 777 $BASEDIR/constant_charge_current
chattr -i $BASEDIR/constant_charge_current_max
chmod 777 $BASEDIR/constant_charge_current_max
chmod 777 $BASEDIR/input_suspend
chattr -i $BASEDIR/fast_charge_current
chmod 777 $BASEDIR/fast_charge_current
chattr -i $BASEDIR/input_suspend
chmod 777 $BASEDIR/input_suspend
echo '0' > $BASEDIR/input_suspend
chmod 666 /data/vendor/thermal/config

# Manual adaptation:
# Find the charging-current limit node for the device. It is usually under
# /sys/class/power_supply/battery. Replace the candidate node names below, or
# add another branch such as:
# elif [ -e "$BASEDIR/your_current_node" ]; then Ccc="your_current_node"
if [ -e "$BASEDIR/constant_charge_current" ]; then
    Ccc="constant_charge_current"
elif [ -e "$BASEDIR/constant_charge_current_max" ]; then
    Ccc="constant_charge_current_max"
elif [ -e "$BASEDIR/fast_charge_current" ]; then
    Ccc="fast_charge_current"
fi
# Adjust the values below to change the temperature limits. Higher requested
# current does not necessarily improve charging speed. The reduction threshold
# must remain lower than the stop threshold.
# Temperature where current reduction begins, in tenths of a degree Celsius.
start=420
# Temperature where charging stops, in tenths of a degree Celsius.
stop=480
# Battery percentage where trickle charging begins.
trickle=85
# Trickle-charging current in microamps. The default is 2,000 mA.
trickle_current=2000000
# Divide the range between the reduction and stop thresholds into six steps.
interval=$((($stop-$start)/6))
data=`[[ -f $warm ]] && cat $warm`
data2=`[[ -f $power ]] && cat $power`

while true; do
  sleep 3s
  if [[ $data -le $start && $data2 -le $trickle ]]; then
    echo '21400000' > $BASEDIR/$Ccc
  elif [[ $data -ge $start && $data -le $((start+interval)) && $data2 -le $trickle ]]; then
    echo '12400000' > $BASEDIR/$Ccc
  elif [[ $data -ge $((start+interval)) && $data -le $((start+2*interval)) && $data2 -le $trickle ]]; then
    echo '8000000' > $BASEDIR/$Ccc
  elif [[ $data -ge $((start+2*interval)) && $data -le $((start+3*interval)) && $data2 -le $trickle ]]; then
    echo '6000000' > $BASEDIR/$Ccc
  elif [[ $data -ge $((start+3*interval)) && $data -le $((start+4*interval)) && $data2 -le $trickle ]]; then
    echo '5000000' > $BASEDIR/$Ccc
  elif [[ $data -ge $((start+4*interval)) && $data -le $((start+5*interval)) && $data2 -le $trickle ]]; then
    echo '4000000' > $BASEDIR/$Ccc
  elif [[ $data -ge $((start+5*interval)) && $data -le $stop && $data2 -le $trickle ]]; then
    echo '3000000' > $BASEDIR/$Ccc
  elif [[ $data -ge $stop ]]; then
    echo '0' > $BASEDIR/$Ccc
  elif [[ $data -le $stop && $data2 -ge $trickle ]]; then
    echo $trickle_current > $BASEDIR/$Ccc
fi
done
